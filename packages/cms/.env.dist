NODE_ENV=development

PASSPORT_SECRET=!ChangeMe!

API_PORT=3000
CMS_PORT=5000

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=periodtracker
DATABASE_PASSWORD=periodtracker
DATABASE_NAME=periodtracker
DATABASE_SCHEMA=periodtracker
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true

DEFAULT_LOCALE=en

# Optional
STORAGE_BUCKET=
STORAGE_BASE_URL=

# Firebase service account JSON, base64 encoded on one line. Only for deployments
# that cannot provide the firebase-config.json key file (e.g. AWS ECS env files).
# Leave empty to use the key file, see docs/setup.md.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Feature flags: set to true to enable, see FEATURE_FLAGS.md
FEATURE_VOICE_OVER=false
FEATURE_CONTENT_FILTER=false
FEATURE_AGE_RESTRICTION_LEVELS=false

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=
SLOW_QUERY_THRESHOLD=1000
SLOW_REQUEST_THRESHOLD=3000
